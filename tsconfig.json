{
    "compilerOptions": {
        "strict": true,
        "module": "esnext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "bundler",
        "target": "esnext",
        "declaration": false,
        "noEmitOnError": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "types": ["jest", "node"],
        "outDir": "./dist"
    },
    "include": [
        "./src/**/*",
        "./__tests__/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
